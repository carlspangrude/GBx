---
// A row of card images with a caption. Usage: <CardRow names={['Tarmogoyf','Thoughtseize']} caption="..." />
import { imgUrl } from '../lib/scryfall';
interface Props { names: string[]; caption?: string }
const { names, caption } = Astro.props;
const src = (n: string) => imgUrl(n);
const page = (n: string) => `https://scryfall.com/search?q=${encodeURIComponent(`!"${n}"`)}`;
---
<figure class="card-row">
  <div class="card-row-grid">
    {names.map((n) => (
      <a href={page(n)} target="_blank" rel="noopener"><img src={src(n)} alt={n} loading="lazy" width="244" height="340" /></a>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
