---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { pillars, pillarKeys } from '../../data/pillars';

export function getStaticPaths() {
  return pillarKeys.map((k) => ({ params: { pillar: k } }));
}
const key = Astro.params.pillar as keyof typeof pillars;
const posts = (await getCollection('posts', (p) => !p.data.draft && p.data.pillar === key))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={pillars[key].name} description={pillars[key].blurb}>
  <div class="page">
    <h1>{pillars[key].name}</h1>
    <p class="lede">{pillars[key].blurb}</p>
    {posts.length ? <PostList posts={posts} /> : <p>No posts here yet.</p>}
  </div>
</Base>
