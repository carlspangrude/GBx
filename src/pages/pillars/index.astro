---
import Base from '../../layouts/Base.astro';
import { pillars, pillarKeys } from '../../data/pillars';
---
<Base title="Pillars">
  <div class="page">
    <h1>Pillars</h1>
    <p class="lede">The recurring components of the philosophy. Each one collects the posts that explain it.</p>
    <ul class="pillars">
      {pillarKeys.map((k) => (
        <li><a href={`/pillars/${k}/`}>{pillars[k].name}</a><p>{pillars[k].blurb}</p></li>
      ))}
    </ul>
  </div>
</Base>
