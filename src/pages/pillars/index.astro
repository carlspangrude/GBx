---
import Base from '../../layouts/Base.astro';
import PillarTile from '../../components/PillarTile.astro';
import { pillarKeys } from '../../data/pillars';
---
<Base title="Pillars">
  <div class="page">
    <h1>Pillars</h1>
    <p class="lede">The recurring components of the philosophy. Each one collects the posts that explain it.</p>
    <div class="tiles">{pillarKeys.map((k) => <PillarTile k={k} />)}</div>
  </div>
</Base>
