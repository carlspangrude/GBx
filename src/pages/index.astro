---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { pillars, pillarKeys } from '../data/pillars';
const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
  <div class="page">
    <h1 style="max-width: 18ch">Win by never falling behind.</h1>
    <p class="lede">
      A reference on midrange built from individually powerful cards: cheap disruption,
      efficient threats, and 1-for-1 trades until card quality takes over. Jund is the
      touchstone, but the philosophy works in any colors.
    </p>

    <h2 class="section-title">The pillars</h2>
    <ul class="pillars">
      {pillarKeys.map((k) => (
        <li>
          <a href={`/pillars/${k}/`}>{pillars[k].name}</a>
          <p>{pillars[k].blurb}</p>
        </li>
      ))}
    </ul>

    <h2 class="section-title">Latest posts</h2>
    <PostList posts={posts.slice(0, 5)} />
  </div>
</Base>
